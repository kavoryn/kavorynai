APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080

# Supabase Auth identity verification (server-side configuration only).
# Use the project URL and publishable key; never use a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Configure secrets only in the server's secret manager.
# Never commit real values or expose them to the Android application.
DATABASE_URL=
AI_PROVIDER=
AI_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
PAYSTACK_SECRET_KEY=
