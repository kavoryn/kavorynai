APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080

# Supabase Auth identity verification (server-side configuration only).
# Use the project URL and publishable key; never use a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side database access only. Never commit real values or ship them in Android.
SUPABASE_SECRET_KEY=
# Temporary legacy service_role JWT used as Authorization bearer while sb_secret
# is sent in apikey. Supabase sunsets legacy keys at end of 2026; migrate before then.
# Never expose this value.
SUPABASE_SERVICE_ROLE_KEY=
CONSENT_TTL_SECONDS=300

# Absolute path OUTSIDE backend/public; create with owner-only permissions.
PRIVATE_DOCUMENT_STORAGE_PATH=
# Keep false until retention cleanup, HTTPS, quotas and host tests are complete.
DOCUMENT_UPLOAD_ENABLED=false

# Google Cloud Vision OCR. Use a dedicated service-account JSON file, not an API key
# or OAuth client secret. Store the JSON outside the repository and outside web root.
OCR_PROVIDER=google_cloud_vision
# Absolute server-side path to the service-account JSON file. This is the variable
# read by backend/bin/ocr_worker.php; do not put the JSON contents or credentials here.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_CLOUD_PROJECT_ID=

# OCR worker controls. Keep disabled until staging and end-to-end checks are approved.
OCR_WORKER_ENABLED=false
# Maximum jobs processed per worker invocation (worker clamps this to 1..10).
OCR_WORKER_MAX_JOBS=3

# Base64-encoded 32-byte random key for encrypting OCR results with PHP sodium.
# Generate and store a unique secret in the server environment; never commit a real key.
OCR_RESULT_ENCRYPTION_KEY=
# Current sink implementation accepts key version 1; coordinate any rotation first.
OCR_RESULT_ENCRYPTION_KEY_VERSION=1

# AI document explanation and Q&A providers. Secrets stay server-side only.
# Keep false until staging and Android end-to-end tests pass.
DOCUMENT_QA_ENABLED=false
# Consent is required before OCR text is sent to either external AI provider.
OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional provider compatibility settings; leave unset unless an adapter requires them.
DATABASE_URL=
AI_API_KEY=
OCR_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
PAYSTACK_SECRET_KEY=
