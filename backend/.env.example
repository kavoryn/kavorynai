APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080

# Supabase Auth identity verification (server-side configuration only).
# Use the project URL and publishable key; never use a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side database access only. Never commit real values or ship them in Android.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT used as the database Authorization bearer while the new
# sb_secret key is sent in apikey. Rotate/migrate deliberately; never expose it.
SUPABASE_SERVICE_ROLE_KEY=
CONSENT_TTL_SECONDS=300

# Configure secrets only in the server's secret manager.
# Never commit real values or expose them to the Android application.
DATABASE_URL=
AI_PROVIDER=
AI_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
PAYSTACK_SECRET_KEY=
